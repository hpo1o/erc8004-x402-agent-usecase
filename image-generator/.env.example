# ── OpenAI ────────────────────────────────────────────────────────────────────
# API key for GPT Image 2 generation.
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-2

# ── x402 payment ──────────────────────────────────────────────────────────────
# Private key of the wallet that pays colorizer-service $0.01 USDC per call.
# Must have ETH (gas) and USDC on Base Sepolia.
# Format: 0x + 64 hex chars.
# Get testnet ETH  : https://www.alchemy.com/faucets/base-sepolia
# Get testnet USDC : https://faucet.circle.com  (select Base Sepolia)
PAYER_PRIVATE_KEY=0x...

# ── colorizer-service ─────────────────────────────────────────────────────────
# Leave empty to use ERC-8004 discovery (recommended).
# Set to override discovery for local development:
# COLORIZER_URL=http://localhost:3000/agent
COLORIZER_URL=

# ── ERC-8004 evidence (optional) ────────────────────────────────────────────
# Configure PINATA_JWT and the Agent 2 owner key in ../erc8004/.env.
# PAYER_PRIVATE_KEY above signs reputation and validation responses.

# Address that receives USDC payments — used only in dev mode (COLORIZER_URL set).
# In production, payment recipient is read from ERC-8004 agentWallet on-chain
# (returned by discoverColorizer()) and this variable is ignored.
PAYMENT_RECIPIENT_ADDRESS=0x...
