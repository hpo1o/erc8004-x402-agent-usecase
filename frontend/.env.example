# ── OpenAI image generation ───────────────────────────────────────────────────
# Required for prompt generation. In Vercel, add this to both Production and
# Preview environments and redeploy after changing it.
OPENAI_API_KEY=sk-...
# Optional override; gpt-image-2 is the supported default. Free API tier does
# not support image generation.

OPENAI_IMAGE_MODEL=gpt-image-2

# ── Two-wallet ERC-8004/x402 setup ───────────────────────────────────────────
# Agent 1: pays x402, submits reputation, and acts as independent validator.
PAYER_PRIVATE_KEY=0x...

# Agent 2: owns ERC-8004 agentId 2214 and requests validation.
ERC8004_PRIVATE_KEY=0x...

# Pinata JWT for reputation and validation evidence.
PINATA_JWT=eyJ...

# Base Sepolia RPC (optional).
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Agent 2 x402 seller. This is a public receiving address, not a private key.
# Defaults to the registered Agent 2 wallet shown below.
PAYMENT_RECIPIENT_ADDRESS=0x171c4E80E4cA6bBe95Eb38D9d226b52897350dBb

# Optional overrides. Vercel normally calls its own /api/agent deployment and
# uses the public testnet facilitator automatically.
# COLORIZER_URL=https://your-project.vercel.app/api/agent
# X402_FACILITATOR_URL=https://x402.org/facilitator

# Emergency development-only switch. Keep false in Vercel: a successful run
# must include a real x402 settlement.
ALLOW_LOCAL_COLORIZER_FALLBACK=false

# ── Public-service protection ─────────────────────────────────────────────────
# Strongly recommended on a public/custom domain. Visitors enter this value in
# the Access token field. Leave empty only for a deliberately public demo.
SERVICE_ACCESS_TOKEN=replace-with-a-long-random-value

# Per-IP generation limit.
PROCESS_RATE_LIMIT_MAX=10
PROCESS_RATE_LIMIT_WINDOW_MS=3600000

# Railway sets PORT automatically. Only needed for local development.
PORT=3001
